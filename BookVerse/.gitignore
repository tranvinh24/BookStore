# Module-level gitignore (BookVerse Spring Boot module)
# Hầu hết các rule đã được cover bởi root .gitignore
# File này giữ lại để Spring Initializr không ghi đè root rules

# Maven build output
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# IntelliJ IDEA
.idea/
*.iws
*.iml
*.ipr

# Eclipse / STS
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/
build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/

# Logs
*.log

# Environment files
.env
application-local.*

# Spring default template file
HELP.md
