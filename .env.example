# ============================================================
# BookVerse - Environment Variables Template
# ============================================================
# Hướng dẫn:
#   1. Copy file này thành .env (hoặc set trực tiếp trong hệ thống)
#   2. Điền giá trị thực của bạn vào
#   3. File .env sẽ KHÔNG được commit lên Git (đã gitignore)
# ============================================================

# Database
DB_URL=jdbc:mysql://localhost:3306/bookstore
DB_USERNAME=root
DB_PASSWORD=your_password_here
