# Cấu hình Cơ sở dữ liệu (Database)
DB_URL=jdbc:mysql://localhost:3306/bookstore
DB_USERNAME=root
DB_PASSWORD=your_database_password

# Bảo mật JWT
JWT_SECRET=your_jwt_secret_key_minimum_64_characters

# Dịch vụ Cloudinary (Lưu trữ ảnh bìa và avatar)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Cổng thanh toán VNPay Sandbox
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:8080/payment.html
