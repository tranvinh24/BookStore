      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:wght@500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n@import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css');\n\n.bv-page {\n  --paper: #FBF3EC;\n  --paper-warm: #F4E8DC;\n  --paper-dark: #EAD8C7;\n  --paper-card: #FFFFFF;\n  --ink: #2B2140;\n  --ink-secondary: #584B6E;\n  --ink-muted: #81758E;\n  --border: #E1D3C5;\n  --marigold: #E28725;\n  --marigold-soft: #FEF3E6;\n  --sage: #287C68;\n  --sage-soft: #E8F5F1;\n  --coral: #D94A3D;\n  --coral-soft: #FDEEED;\n  --lavender: #6A4BC4;\n  --lavender-soft: #F1EDFC;\n  --font-body: 'Be Vietnam Pro', sans-serif;\n  --font-heading: 'Lora', Georgia, serif;\n  --font-number: 'Space Grotesk', monospace;\n  min-height: 100vh;\n  background: var(--paper);\n  color: var(--ink);\n  font-family: var(--font-body);\n  font-size: 14px;\n  line-height: 1.55;\n  letter-spacing: -0.01em;\n}\n.bv-page, .bv-page * { box-sizing: border-box; }\n.bv-page h1, .bv-page h2, .bv-page h3, .bv-page p, .bv-page ul { margin: 0; }\n.bv-page ul { list-style: none; padding: 0; }\n.bv-page button, .bv-page input, .bv-page select { font: inherit; }\n.bv-page a { color: inherit; text-decoration: none; }\n.bv-page button { cursor: pointer; }\n.bv-shell { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }\n.font-heading { font-family: var(--font-heading); }\n.font-number { font-family: var(--font-number); font-variant-numeric: tabular-nums lining-nums; }\n.icon { line-height: 1; }\n\n/* Customer rail */\n.site-header {\n  height: 72px;\n  background: var(--paper);\n  border-bottom: 1px solid var(--border);\n  display: flex;\n  align-items: center;\n}\n.site-header__inner { width: min(1180px, calc(100% - 64px)); margin: 0 auto; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 24px; }\n.brand { display: inline-flex; align-items: center; gap: 10px; width: fit-content; font-family: var(--font-heading); font-size: 22px; font-weight: 700; letter-spacing: -0.04em; }\n.brand__mark { width: 34px; height: 34px; display: inline-flex; align-items: center; justify-content: center; color: var(--paper); background: var(--ink); border-radius: 5px; font-size: 19px; }\n.brand__mark .icon { color: #DDEBFF; }\n.main-nav { display: flex; align-items: center; justify-content: center; gap: 26px; }\n.main-nav a { position: relative; padding: 8px 0; color: var(--ink-secondary); font-size: 13px; font-weight: 600; }\n.main-nav a[aria-current=\"page\"] { color: var(--ink); }\n.main-nav a[aria-current=\"page\"]::after { content: ''; position: absolute; left: 0; right: 0; bottom: 2px; height: 2px; background: var(--ink); }\n.header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; }\n.header-action { min-height: 40px; display: inline-flex; align-items: center; gap: 8px; padding: 0 13px; border: 1px solid var(--border); background: transparent; color: var(--ink-secondary); border-radius: 5px; font-size: 13px; font-weight: 600; }\n.header-action--solid { border-color: var(--ink); background: var(--ink); color: var(--paper); }\n.header-action:hover { border-color: var(--ink); color: var(--ink); }\n.header-action--solid:hover { background: #3B2E55; color: var(--paper); }\n.header-action .icon { font-size: 17px; }\n.menu-toggle { display: none; min-height: 40px; width: 40px; padding: 0; border: 1px solid var(--border); background: transparent; color: var(--ink); border-radius: 5px; }\n\n/* Catalog masthead */\n.catalog-masthead { position: relative; padding: 48px 0 42px; border-bottom: 1px solid var(--border); overflow: hidden; }\n.catalog-masthead::after { content: ''; position: absolute; width: 42%; height: 78%; right: -5%; top: 11%; background: var(--paper-dark); opacity: .44; pointer-events: none; }\n.catalog-masthead__grid { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1.12fr) minmax(390px, .88fr); gap: 72px; align-items: end; }\n.masthead-copy { max-width: 610px; }\n.masthead-kicker { display: flex; align-items: center; gap: 10px; margin-bottom: 15px; color: var(--ink-muted); font-family: var(--font-number); font-size: 11px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }\n.masthead-kicker::before { content: ''; width: 28px; height: 2px; background: var(--marigold); }\n.masthead-title { max-width: 560px; font-family: var(--font-heading); font-size: clamp(34px, 4vw, 52px); line-height: 1.1; letter-spacing: -.05em; font-weight: 600; }\n.masthead-description { max-width: 520px; margin-top: 17px; color: var(--ink-secondary); font-size: 15px; line-height: 1.75; }\n.catalog-search-panel { padding: 24px; border: 1px solid var(--border); background: rgba(255,255,255,.54); }\n.catalog-search-panel__label { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-bottom: 12px; color: var(--ink-muted); font-family: var(--font-number); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; }\n.catalog-search-panel__label strong { color: var(--ink); font-family: var(--font-body); font-size: 13px; letter-spacing: 0; text-transform: none; }\n.search-form { display: flex; gap: 9px; }\n.search-field { position: relative; flex: 1; }\n.search-field .icon { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); color: var(--ink-muted); font-size: 18px; }\n.search-field input { width: 100%; min-height: 46px; padding: 0 13px 0 40px; border: 1px solid var(--border); border-radius: 4px; background: var(--paper); color: var(--ink); outline: none; }\n.search-field input:focus { border-color: var(--ink); box-shadow: 0 0 0 3px rgba(43,33,64,.1); }\n.search-button { min-height: 46px; padding: 0 18px; border: 1px solid var(--ink); border-radius: 4px; background: var(--ink); color: var(--paper); font-weight: 700; }\n.search-button:hover { background: #3B2E55; }\n.search-panel-note { margin-top: 13px; color: var(--ink-muted); font-size: 12px; }\n.search-panel-note strong { color: var(--ink); font-family: var(--font-number); }\n\n/* Catalog index */\n.catalog-section { padding: 34px 0 58px; }\n.catalog-toolbar { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding-bottom: 20px; border-bottom: 1px solid var(--border); }\n.catalog-toolbar__title { display: flex; align-items: baseline; gap: 12px; }\n.catalog-toolbar__title h2 { font-family: var(--font-heading); font-size: 25px; line-height: 1.2; font-weight: 600; }\n.catalog-toolbar__title span { color: var(--ink-muted); font-size: 12px; }\n.catalog-toolbar__actions { display: flex; align-items: center; gap: 10px; }\n.sort-label { color: var(--ink-muted); font-size: 12px; }\n.sort-select { min-height: 38px; padding: 0 32px 0 11px; border: 1px solid var(--border); border-radius: 4px; background: var(--paper); color: var(--ink); font-size: 12px; }\n.filter-trigger { display: none; min-height: 38px; padding: 0 12px; border: 1px solid var(--border); background: var(--paper); color: var(--ink); border-radius: 4px; font-weight: 600; }\n.catalog-layout { display: grid; grid-template-columns: 215px minmax(0, 1fr); gap: 28px; padding-top: 27px; }\n.catalog-strip { padding-right: 22px; border-right: 1px solid var(--border); }\n.catalog-strip__header { display: flex; align-items: center; justify-content: space-between; margin-bottom: 26px; }\n.catalog-strip__header h3 { font-size: 13px; font-weight: 700; }\n.reset-link { border: 0; padding: 0; background: none; color: var(--ink-muted); font-size: 11px; text-decoration: underline; text-underline-offset: 3px; }\n.filter-group { padding: 0 0 22px; margin-bottom: 22px; border-bottom: 1px solid var(--border); }\n.filter-group:last-child { border-bottom: 0; margin-bottom: 0; }\n.filter-group__label { margin-bottom: 10px; color: var(--ink-muted); font-family: var(--font-number); font-size: 10px; font-weight: 600; letter-spacing: .1em; text-transform: uppercase; }\n.filter-list { display: grid; gap: 3px; }\n.filter-list button { position: relative; width: 100%; padding: 7px 8px 7px 0; border: 0; background: transparent; color: var(--ink-secondary); text-align: left; font-size: 12px; }\n.filter-list button:hover, .filter-list button.is-active { color: var(--ink); font-weight: 700; }\n.filter-list button.is-active::before { content: ''; position: absolute; left: -9px; top: 8px; bottom: 8px; width: 3px; background: var(--ink); }\n.filter-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }\n.filter-inputs input { min-width: 0; width: 100%; min-height: 34px; padding: 0 8px; border: 1px solid var(--border); background: var(--paper); color: var(--ink); border-radius: 3px; font-family: var(--font-number); font-size: 11px; }\n.filter-submit { width: 100%; min-height: 34px; margin-top: 8px; border: 1px solid var(--border); border-radius: 3px; background: var(--paper-warm); color: var(--ink); font-size: 11px; font-weight: 700; }\n.active-filters { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px; }\n.active-filter { display: inline-flex; align-items: center; gap: 6px; min-height: 24px; padding: 0 8px; border: 1px solid rgba(106,75,196,.25); background: var(--lavender-soft); color: var(--lavender); border-radius: 3px; font-size: 10px; font-weight: 600; }\n.active-filter button { display: inline-flex; border: 0; padding: 0; background: transparent; color: inherit; }\n\n/* Cover wall */\n.cover-wall { position: relative; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 31px 20px; }\n.book-tile { position: relative; min-width: 0; padding-top: 7px; }\n.catalog-mark { position: absolute; top: -9px; left: -13px; color: var(--ink-muted); font-family: var(--font-number); font-size: 10px; letter-spacing: .08em; }\n.book-cover { position: relative; aspect-ratio: 2 / 3; overflow: hidden; border: 1px solid var(--border); background: var(--paper-warm); }\n.book-cover img { width: 100%; height: 100%; display: block; object-fit: cover; }\n.book-cover__fallback { width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 10px; padding: 18px; background: var(--paper-warm); color: var(--ink-muted); text-align: center; }\n.book-cover__fallback .icon { color: var(--ink-secondary); font-size: 30px; }\n.book-cover__fallback strong { max-width: 110px; color: var(--ink); font-family: var(--font-heading); font-size: 15px; line-height: 1.25; }\n.book-cover__fallback span { font-family: var(--font-number); font-size: 9px; letter-spacing: .12em; text-transform: uppercase; }\n.status { position: absolute; top: 9px; left: 9px; display: inline-flex; align-items: center; min-height: 23px; padding: 0 7px; border: 1px solid; border-radius: 3px; font-family: var(--font-number); font-size: 9px; font-weight: 700; letter-spacing: .04em; text-transform: uppercase; }\n.status--sage { border-color: rgba(40,124,104,.28); background: rgba(232,245,241,.94); color: var(--sage); }\n.status--coral { border-color: rgba(217,74,61,.28); background: rgba(253,238,237,.95); color: var(--coral); }\n.status--marigold { border-color: rgba(226,135,37,.28); background: rgba(254,243,230,.95); color: var(--marigold); }\n.book-tile__body { padding-top: 11px; }\n.book-tile__category { color: var(--ink-muted); font-family: var(--font-number); font-size: 9px; font-weight: 700; letter-spacing: .11em; text-transform: uppercase; }\n.book-tile__title { margin-top: 3px !important; font-family: var(--font-heading); font-size: 16px; line-height: 1.25; font-weight: 600; }\n.book-tile__author { margin-top: 4px !important; color: var(--ink-secondary); font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }\n.book-tile__meta { display: flex; align-items: center; gap: 10px; margin-top: 8px; color: var(--ink-muted); font-family: var(--font-number); font-size: 10px; }\n.book-tile__meta .rating { color: var(--marigold); font-weight: 700; }\n.book-tile__footer { display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-top: 11px; padding-top: 10px; border-top: 1px solid var(--border); }\n.book-price { color: var(--ink); font-family: var(--font-number); font-size: 16px; font-weight: 700; white-space: nowrap; }\n.book-action { display: inline-flex; align-items: center; gap: 5px; border: 0; padding: 0; background: transparent; color: var(--ink); font-size: 10px; font-weight: 700; }\n.book-action:hover { text-decoration: underline; text-underline-offset: 3px; }\n.book-action[disabled] { color: var(--ink-muted); cursor: not-allowed; text-decoration: none; }\n.favorite-button { position: absolute; top: 10px; right: 10px; width: 31px; height: 31px; display: inline-flex; align-items: center; justify-content: center; border: 1px solid rgba(255,255,255,.7); background: rgba(251,243,236,.92); color: var(--ink-secondary); border-radius: 50%; }\n.favorite-button:hover { border-color: var(--ink); color: var(--coral); }\n.favorite-button .icon { font-size: 15px; }\n\n/* Lower foundation previews */\n.foundation-previews { padding: 0 0 65px; }\n.foundation-intro { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; padding-bottom: 14px; border-bottom: 1px solid var(--border); }\n.foundation-intro h2 { font-family: var(--font-heading); font-size: 22px; font-weight: 600; }\n.foundation-intro p { color: var(--ink-muted); font-size: 11px; }\n.preview-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.08fr); gap: 20px; padding-top: 20px; }\n.preview-panel { min-width: 0; border: 1px solid var(--border); background: rgba(255,255,255,.36); }\n.preview-panel__bar { display: flex; align-items: center; justify-content: space-between; padding: 13px 16px; border-bottom: 1px solid var(--border); }\n.preview-panel__bar span { color: var(--ink-muted); font-family: var(--font-number); font-size: 9px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n.preview-panel__bar strong { font-size: 12px; }\n.record-preview { display: grid; grid-template-columns: minmax(0, 1fr) 192px; gap: 20px; padding: 19px; }\n.record-copy__category { color: var(--lavender); font-family: var(--font-number); font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }\n.record-copy h3 { margin-top: 7px !important; font-family: var(--font-heading); font-size: 25px; line-height: 1.15; }\n.record-copy__author { margin-top: 6px !important; color: var(--ink-secondary); font-size: 12px; }\n.record-copy__description { margin-top: 18px !important; max-width: 34ch; color: var(--ink-secondary); font-size: 11px; line-height: 1.7; }\n.record-facts { display: grid; grid-template-columns: 92px 1fr; gap: 7px 10px; margin-top: 18px; padding-top: 13px; border-top: 1px solid var(--border); font-size: 10px; }\n.record-facts dt { color: var(--ink-muted); }\n.record-facts dd { margin: 0; color: var(--ink); font-family: var(--font-number); font-weight: 600; }\n.purchase-docket { align-self: start; padding: 14px; border: 1px solid var(--border); background: var(--paper-card); }\n.docket-status { color: var(--sage); font-family: var(--font-number); font-size: 9px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }\n.docket-label { margin-top: 11px; color: var(--ink-muted); font-size: 9px; }\n.docket-price { margin-top: 1px; font-family: var(--font-number); font-size: 21px; font-weight: 700; }\n.docket-meta { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: 13px; padding: 10px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }\n.docket-meta span { display: block; color: var(--ink-muted); font-size: 9px; }\n.docket-meta strong { display: block; margin-top: 2px; font-family: var(--font-number); font-size: 11px; }\n.docket-quantity { display: flex; align-items: center; justify-content: space-between; margin-top: 13px; color: var(--ink-secondary); font-size: 10px; }\n.quantity-control { display: inline-flex; align-items: center; border: 1px solid var(--border); }\n.quantity-control button { width: 26px; height: 26px; border: 0; background: transparent; color: var(--ink); }\n.quantity-control span { min-width: 25px; color: var(--ink); font-family: var(--font-number); font-size: 10px; text-align: center; }\n.docket-actions { display: grid; gap: 6px; margin-top: 13px; }\n.docket-actions button { min-height: 32px; border: 1px solid var(--ink); border-radius: 3px; background: var(--ink); color: var(--paper); font-size: 10px; font-weight: 700; }\n.docket-actions button + button { border-color: var(--marigold); background: var(--marigold); }\n.docket-save { display: inline-flex; align-items: center; justify-content: center; gap: 5px; margin-top: 9px; border: 0; background: transparent; color: var(--ink-secondary); font-size: 10px; }\n\n/* Ledger preview */\n.ledger-preview { display: grid; grid-template-columns: 114px minmax(0, 1fr); min-height: 270px; }\n.ledger-rail { padding: 18px 13px; background: var(--ink); color: var(--paper); }\n.ledger-rail__brand { display: flex; align-items: center; gap: 7px; padding-bottom: 17px; border-bottom: 1px solid rgba(251,243,236,.2); font-family: var(--font-heading); font-size: 13px; font-weight: 600; }\n.ledger-rail__brand .icon { color: var(--marigold); font-size: 15px; }\n.ledger-nav { display: grid; gap: 5px; margin-top: 18px; }\n.ledger-nav a { position: relative; display: flex; align-items: center; gap: 7px; padding: 7px 5px; color: rgba(251,243,236,.64); font-size: 9px; }\n.ledger-nav a .icon { font-size: 14px; }\n.ledger-nav a.is-active { color: var(--paper); background: rgba(251,243,236,.08); }\n.ledger-nav a.is-active::before { content: ''; position: absolute; left: -13px; top: 5px; bottom: 5px; width: 2px; background: var(--marigold); }\n.ledger-main { min-width: 0; padding: 16px; background: var(--paper-card); }\n.ledger-main__heading { display: flex; align-items: center; justify-content: space-between; gap: 10px; }\n.ledger-main__heading h3 { font-family: var(--font-heading); font-size: 17px; }\n.ledger-main__heading span { color: var(--ink-muted); font-family: var(--font-number); font-size: 9px; }\n.metric-strip { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 14px; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }\n.metric-cell { min-width: 0; padding: 11px 10px; border-right: 1px solid var(--border); }\n.metric-cell:last-child { border-right: 0; }\n.metric-cell__label { color: var(--ink-muted); font-size: 8px; line-height: 1.3; }\n.metric-cell__value { margin-top: 5px; font-family: var(--font-number); font-size: 14px; font-weight: 700; }\n.metric-cell--revenue .metric-cell__value { color: var(--sage); }\n.metric-cell--pending .metric-cell__value { color: var(--marigold); }\n.recent-orders { margin-top: 16px; }\n.recent-orders__label { margin-bottom: 7px; color: var(--ink-muted); font-family: var(--font-number); font-size: 8px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }\n.ledger-table { width: 100%; border-collapse: collapse; font-size: 9px; }\n.ledger-table th { padding: 7px 6px; border-bottom: 1px solid var(--border); color: var(--ink-muted); font-family: var(--font-number); font-size: 8px; font-weight: 600; text-align: left; }\n.ledger-table td { padding: 8px 6px; border-bottom: 1px solid var(--border); color: var(--ink-secondary); white-space: nowrap; }\n.ledger-table tbody tr:last-child td { border-bottom: 0; }\n.ledger-table .number { color: var(--ink); font-family: var(--font-number); font-weight: 600; }\n.table-status { color: var(--sage); font-weight: 700; }\n.table-status--pending { color: var(--marigold); }\n\n/* Footer */\n.site-footer { padding: 20px 0 27px; border-top: 1px solid var(--border); color: var(--ink-muted); font-size: 10px; }\n.site-footer__inner { display: flex; align-items: center; justify-content: space-between; gap: 20px; }\n.site-footer__brand { color: var(--ink-secondary); font-family: var(--font-heading); font-size: 13px; font-weight: 600; }\n\n/* Responsive foundation */\n@media (max-width: 1080px) {\n  .cover-wall { grid-template-columns: repeat(3, minmax(0, 1fr)); }\n  .catalog-masthead__grid { gap: 42px; }\n}\n@media (max-width: 820px) {\n  .bv-shell, .site-header__inner { width: min(100% - 36px, 680px); }\n  .site-header { height: 64px; }\n  .site-header__inner { grid-template-columns: 1fr auto; }\n  .main-nav { display: none; position: absolute; left: 18px; right: 18px; top: 72px; z-index: 20; padding: 11px 15px; flex-direction: column; align-items: stretch; gap: 1px; border: 1px solid var(--border); background: var(--paper-card); }\n  .main-nav.is-open { display: flex; }\n  .main-nav a { padding: 11px 3px; }\n  .header-actions { display: none; }\n  .menu-toggle { display: inline-flex; align-items: center; justify-content: center; }\n  .catalog-masthead { padding: 38px 0 32px; }\n  .catalog-masthead::after { width: 65%; height: 35%; right: -18%; top: 55%; }\n  .catalog-masthead__grid { grid-template-columns: 1fr; gap: 26px; }\n  .catalog-search-panel { max-width: none; }\n  .catalog-layout { grid-template-columns: 1fr; }\n  .catalog-strip { display: none; padding: 18px 0 0; border-right: 0; border-top: 1px solid var(--border); }\n  .catalog-strip.is-open { display: block; }\n  .filter-trigger { display: inline-flex; align-items: center; gap: 7px; }\n  .catalog-toolbar { align-items: flex-start; }\n  .catalog-toolbar__actions { flex-wrap: wrap; justify-content: flex-end; }\n  .sort-label { display: none; }\n  .cover-wall { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 27px 15px; }\n  .preview-grid { grid-template-columns: 1fr; }\n  .ledger-preview { min-height: 0; }\n}\n@media (max-width: 520px) {\n  .bv-shell, .site-header__inner { width: calc(100% - 28px); }\n  .brand { font-size: 19px; }\n  .brand__mark { width: 31px; height: 31px; font-size: 17px; }\n  .catalog-masthead { padding: 30px 0 27px; }\n  .masthead-title { font-size: 32px; }\n  .masthead-description { font-size: 13px; }\n  .search-form { display: grid; grid-template-columns: 1fr auto; }\n  .search-button { padding: 0 13px; }\n  .catalog-section { padding-top: 24px; }\n  .catalog-toolbar { display: grid; gap: 13px; }\n  .catalog-toolbar__actions { justify-content: space-between; }\n  .sort-select { flex: 1; }\n  .record-preview { grid-template-columns: 1fr; gap: 17px; }\n  .record-copy__description { max-width: none; }\n  .purchase-docket { max-width: none; }\n  .ledger-preview { grid-template-columns: 1fr; }\n  .ledger-rail { display: none; }\n  .metric-strip { grid-template-columns: repeat(2, 1fr); }\n  .metric-cell:nth-child(2) { border-right: 0; }\n  .metric-cell:nth-child(-n+2) { border-bottom: 1px solid var(--border); }\n  .ledger-main { overflow-x: auto; }\n  .ledger-table { min-width: 420px; }\n  .site-footer__inner { align-items: flex-start; flex-direction: column; gap: 5px; }\n}\n</style>\n<div class=\"bv-page\" data-kid=\"1\" data-name=\"page wrapper\">\n    <header class=\"site-header\" data-kid=\"1-1\" data-name=\"site header\">\n        <div class=\"site-header__inner\" data-kid=\"1-1-1\" data-name=\"header inner container\">\n            <a aria-label=\"BookVerse — Trang chủ\" class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand logo and name link\" href=\"#catalog\">\n                <span class=\"brand__mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand logo icon container\">\n                    <i aria-hidden=\"true\" class=\"ti ti-book-2 icon\" data-kid=\"1-1-1-1-1-1\" data-name=\"book icon\">\n                    </i>\n                </span>\n                <span data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    BookVerse\n                </span>\n            </a>\n            <nav aria-label=\"Điều hướng chính\" class=\"main-nav\" data-kid=\"1-1-1-2\" data-name=\"main navigation menu\" id=\"customer-nav\">\n                <a aria-current=\"page\" data-kid=\"1-1-1-2-1\" data-name=\"navigation link trang chủ\" href=\"#catalog\">\n                    Trang chủ\n                </a>\n                <a data-kid=\"1-1-1-2-2\" data-name=\"navigation link yêu thích\" href=\"#catalog\">\n                    Yêu thích\n                </a>\n                <a data-kid=\"1-1-1-2-3\" data-name=\"navigation link giỏ hàng\" href=\"#catalog\">\n                    Giỏ hàng\n                </a>\n                <a data-kid=\"1-1-1-2-4\" data-name=\"navigation link đơn mua\" href=\"#records\">\n                    Đơn mua\n                </a>\n            </nav>\n            <div class=\"header-actions\" data-kid=\"1-1-1-3\" data-name=\"header actions container\">\n                <button class=\"header-action\" data-kid=\"1-1-1-3-1\" data-name=\"login button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-user icon\" data-kid=\"1-1-1-3-1-1\" data-name=\"user icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-1-2\" data-name=\"login button label\">\n                        Đăng nhập\n                    </span>\n                </button>\n                <button class=\"header-action header-action--solid\" data-kid=\"1-1-1-3-2\" data-name=\"register button\" type=\"button\">\n                    Đăng ký\n                </button>\n            </div>\n            <button aria-controls=\"customer-nav\" aria-expanded=\"false\" aria-label=\"Mở menu\" class=\"menu-toggle\" data-dynamic=\"true\" data-kid=\"1-1-1-4\" data-name=\"mobile menu toggle button\" data-reason=\"aria-expanded attribute and inner icon updated by script on click\" type=\"button\">\n                <i aria-hidden=\"true\" class=\"ti ti-menu-2 icon\" data-kid=\"1-1-1-4-1\" data-name=\"menu toggle icon\">\n                </i>\n            </button>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"catalog main content area\" id=\"catalog\">\n        <section class=\"catalog-masthead\" data-kid=\"1-2-1\" data-name=\"catalog masthead section\">\n            <div class=\"bv-shell catalog-masthead__grid\" data-kid=\"1-2-1-1\" data-name=\"masthead grid container\">\n                <div class=\"masthead-copy\" data-kid=\"1-2-1-1-1\" data-name=\"masthead copy container\">\n                    <div class=\"masthead-kicker\" data-kid=\"1-2-1-1-1-1\" data-name=\"masthead kicker label\">\n                        BookVerse / Catalog 2026\n                    </div>\n                    <h1 class=\"masthead-title\" data-kid=\"1-2-1-1-1-2\" data-name=\"masthead headline\">\n                        Đắm mình vào từng trang sách hay\n                    </h1>\n                    <p class=\"masthead-description\" data-kid=\"1-2-1-1-1-3\" data-name=\"masthead description text\">\n                        Tuyển tập tác phẩm từ văn học, kinh tế, công nghệ đến kỹ năng sống — sắp xếp rõ ràng để bạn tìm đúng cuốn sách cần đọc.\n                    </p>\n                </div>\n                <div class=\"catalog-search-panel\" data-kid=\"1-2-1-1-2\" data-name=\"catalog search panel\">\n                    <div class=\"catalog-search-panel__label\" data-kid=\"1-2-1-1-2-1\" data-name=\"search panel label group\">\n                        <span data-kid=\"1-2-1-1-2-1-1\" data-name=\"search panel label text\">\n                            Tìm trong danh mục\n                        </span>\n                        <strong data-kid=\"1-2-1-1-2-1-2\" data-name=\"search panel count text\">\n                            04 đầu sách\n                        </strong>\n                    </div>\n                    <form class=\"search-form\" data-kid=\"1-2-1-1-2-2\" data-name=\"search form\" role=\"search\">\n                        <label class=\"search-field\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"search field container\">\n                            <i aria-hidden=\"true\" class=\"ti ti-search icon\" data-kid=\"1-2-1-1-2-2-1-1\" data-name=\"search icon\">\n                            </i>\n                            <span data-kid=\"1-2-1-1-2-2-1-2\" data-name=\"search input screen reader label\" style=\"position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0);\">\n                                Tìm theo tên sách, tác giả hoặc mã ISBN\n                            </span>\n                            <input aria-label=\"Tìm theo tên sách, tác giả hoặc mã ISBN\" data-kid=\"1-2-1-1-2-2-1-3\" data-name=\"search input field\" placeholder=\"Tên sách, tác giả, ISBN...\" type=\"search\"/>\n                        </label>\n                        <button class=\"search-button\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"search submit button\" type=\"submit\">\n                            Tìm kiếm\n                        </button>\n                    </form>\n                    <p class=\"search-panel-note\" data-kid=\"1-2-1-1-2-3\" data-name=\"search panel note\">\n                        Đang hiển thị\n                        <strong data-kid=\"1-2-1-1-2-3-1\" data-name=\"shown result count text\">\n                            4\n                        </strong>\n                        trên tổng số\n                        <strong data-kid=\"1-2-1-1-2-3-2\" data-name=\"total result count text\">\n                            4\n                        </strong>\n                        cuốn sách\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"catalog-section\" data-kid=\"1-2-2\" data-name=\"catalog section\">\n            <div class=\"bv-shell\" data-kid=\"1-2-2-1\" data-name=\"catalog shell container\">\n                <div class=\"catalog-toolbar\" data-kid=\"1-2-2-1-1\" data-name=\"catalog toolbar\">\n                    <div class=\"catalog-toolbar__title\" data-kid=\"1-2-2-1-1-1\" data-name=\"catalog toolbar title group\">\n                        <h2 data-kid=\"1-2-2-1-1-1-1\" data-name=\"toolbar heading\">\n                            Tất cả đầu sách\n                        </h2>\n                        <span data-kid=\"1-2-2-1-1-1-2\" data-name=\"result count summary\">\n                            04 kết quả\n                        </span>\n                    </div>\n                    <div class=\"catalog-toolbar__actions\" data-kid=\"1-2-2-1-1-2\" data-name=\"catalog toolbar actions group\">\n                        <button aria-controls=\"catalog-filters\" aria-expanded=\"false\" class=\"filter-trigger\" data-dynamic=\"true\" data-kid=\"1-2-2-1-1-2-1\" data-name=\"filter trigger button\" data-reason=\"aria-expanded attribute updated by script on click\" type=\"button\">\n                            <i aria-hidden=\"true\" class=\"ti ti-adjustments-horizontal icon\" data-kid=\"1-2-2-1-1-2-1-1\" data-name=\"filter icon\">\n                            </i>\n                            <span data-kid=\"1-2-2-1-1-2-1-2\" data-name=\"filter button label\">\n                                Bộ lọc\n                            </span>\n                        </button>\n                        <span class=\"sort-label\" data-kid=\"1-2-2-1-1-2-2\" data-name=\"sort label\">\n                            Sắp xếp\n                        </span>\n                        <select aria-label=\"Sắp xếp danh sách sách\" class=\"sort-select\" data-kid=\"1-2-2-1-1-2-3\" data-name=\"sort dropdown select\">\n                            <option data-kid=\"1-2-2-1-1-2-3-1\" data-name=\"sort option A-Z\">\n                                Tên A → Z\n                            </option>\n                            <option data-kid=\"1-2-2-1-1-2-3-2\" data-name=\"sort option rating\">\n                                Đánh giá cao nhất\n                            </option>\n                            <option data-kid=\"1-2-2-1-1-2-3-3\" data-name=\"sort option date\">\n                                Mới xuất bản\n                            </option>\n                        </select>\n                    </div>\n                </div>\n                <div class=\"catalog-layout\" data-kid=\"1-2-2-1-2\" data-name=\"catalog grid layout\">\n                    <aside aria-label=\"Bộ lọc tìm kiếm\" class=\"catalog-strip\" data-kid=\"1-2-2-1-2-1\" data-name=\"filter sidebar\" id=\"catalog-filters\">\n                        <div class=\"catalog-strip__header\" data-kid=\"1-2-2-1-2-1-1\" data-name=\"filter sidebar header\">\n                            <h3 data-kid=\"1-2-2-1-2-1-1-1\" data-name=\"filter heading\">\n                                Bộ lọc tìm kiếm\n                            </h3>\n                            <button class=\"reset-link\" data-kid=\"1-2-2-1-2-1-1-2\" data-name=\"reset filters button\" type=\"button\">\n                                Đặt lại\n                            </button>\n                        </div>\n                        <div class=\"filter-group\" data-kid=\"1-2-2-1-2-1-2\" data-name=\"category filter group\">\n                            <div class=\"filter-group__label\" data-kid=\"1-2-2-1-2-1-2-1\" data-name=\"category filter label\">\n                                Thể loại\n                            </div>\n                            <div class=\"filter-list\" data-kid=\"1-2-2-1-2-1-2-2\" data-name=\"category filter list\">\n                                <button class=\"is-active\" data-kid=\"1-2-2-1-2-1-2-2-1\" data-name=\"category filter option all\" type=\"button\">\n                                    Tất cả thể loại\n                                </button>\n                                <button data-kid=\"1-2-2-1-2-1-2-2-2\" data-name=\"category filter option business\" type=\"button\">\n                                    Business\n                                </button>\n                                <button data-kid=\"1-2-2-1-2-1-2-2-3\" data-name=\"category filter option programming\" type=\"button\">\n                                    Programming\n                                </button>\n                            </div>\n                        </div>\n                        <div class=\"filter-group\" data-kid=\"1-2-2-1-2-1-3\" data-name=\"price filter group\">\n                            <div class=\"filter-group__label\" data-kid=\"1-2-2-1-2-1-3-1\" data-name=\"price filter label\">\n                                Khoảng giá (VNĐ)\n                            </div>\n                            <div class=\"filter-inputs\" data-kid=\"1-2-2-1-2-1-3-2\" data-name=\"price filter inputs container\">\n                                <input aria-label=\"Giá thấp nhất\" data-kid=\"1-2-2-1-2-1-3-2-1\" data-name=\"price min input\" placeholder=\"Từ\" type=\"number\"/>\n                                <input aria-label=\"Giá cao nhất\" data-kid=\"1-2-2-1-2-1-3-2-2\" data-name=\"price max input\" placeholder=\"Đến\" type=\"number\"/>\n                            </div>\n                            <button class=\"filter-submit\" data-kid=\"1-2-2-1-2-1-3-3\" data-name=\"apply price filter button\" type=\"button\">\n                                Áp dụng giá\n                            </button>\n                        </div>\n                        <div class=\"filter-group\" data-kid=\"1-2-2-1-2-1-4\" data-name=\"year filter group\">\n                            <div class=\"filter-group__label\" data-kid=\"1-2-2-1-2-1-4-1\" data-name=\"year filter label\">\n                                Năm xuất bản\n                            </div>\n                            <input aria-label=\"Năm xuất bản\" class=\"filter-inputs\" data-kid=\"1-2-2-1-2-1-4-2\" data-name=\"year filter input\" placeholder=\"Ví dụ: 2024\" style=\"display:block;min-height:34px;padding:0 8px;border:1px solid var(--border);background:var(--paper);color:var(--ink);border-radius:3px;font-family:var(--font-number);font-size:11px;\" type=\"number\"/>\n                            <button class=\"filter-submit\" data-kid=\"1-2-2-1-2-1-4-3\" data-