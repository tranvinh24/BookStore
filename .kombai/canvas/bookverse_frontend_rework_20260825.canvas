      "html": "<script data-asset-crawler>\n(function() {\n  var q = {};\n  window.__crawlAsset = function(el) {\n    var url = el.dataset.originalSrc || el.dataset.originalHref || el.src || el.href;\n    if (!url || q[url]) return;\n    q[url] = true;\n    fetch('http://localhost:19563/api/assets/crawl', {\n      method: 'POST',\n      headers: { 'Content-Type': 'application/json' },\n      body: JSON.stringify({ url: url, canvasPath: \".kombai/canvas/bookverse_frontend_rework_20260825.canvas\", nodeId: \"inspiration_node_b93fba60768e\" })\n    }).then(function(r) {\n      if (!r.ok) console.warn('[AssetCrawler] crawl response not ok:', r.status, url);\n    }).catch(function(e) {\n      console.warn('[AssetCrawler] crawl fetch failed:', e.message || e, url);\n    });\n  };\n})();\n</script><link href=\"https://fonts.googleapis.com/css2?family=Archivo:wght@500;600&amp;family=Fraunces:ital,opsz,wght@1,9..144,400&amp;display=swap\" rel=\"stylesheet\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n<style>\n  :root{\n    --yellow: #ffe600;\n    --ink: #111111;\n    --blue: #1414e0;\n    --font-sans: \"Archivo\", -apple-system, BlinkMacSystemFont, \"Segoe UI\", Helvetica, Arial, sans-serif;\n    --font-serif: \"Fraunces\", Georgia, serif;\n  }\n\n  *{ box-sizing:border-box; margin:0; padding:0; }\n  html,body{ height:100%; }\n  body{\n    background:var(--yellow);\n    color:var(--ink);\n    font-family:var(--font-sans);\n    -webkit-font-smoothing:antialiased;\n  }\n\n  .hero{\n    position:relative;\n    min-height:100vh;\n    overflow:hidden;\n    display:flex;\n    flex-direction:column;\n  }\n\n  /* ---------- Nav ---------- */\n  .nav{\n    position:relative;\n    z-index:5;\n    display:flex;\n    align-items:center;\n    justify-content:space-between;\n    padding:28px 40px;\n  }\n  .brand{\n    font-size:30px;\n    font-weight:600;\n    letter-spacing:-0.02em;\n    color:var(--blue);\n    text-decoration:none;\n  }\n  .nav-links{\n    display:flex;\n    align-items:center;\n    gap:36px;\n  }\n  .nav-link{\n    color:var(--ink);\n    font-size:16px;\n    font-weight:500;\n    text-decoration:none;\n  }\n  .nav-link:hover{ text-decoration:underline; text-underline-offset:4px; }\n  .clock{\n    font-size:16px;\n    font-weight:500;\n  }\n  .clock sup{ font-size:10px; letter-spacing:0.06em; }\n\n  /* ---------- Center ---------- */\n  .center{\n    position:relative;\n    z-index:4;\n    flex:1;\n    display:flex;\n    flex-direction:column;\n    align-items:center;\n    justify-content:center;\n    text-align:center;\n    padding:40px 24px 90px;\n  }\n  .eyebrow{\n    font-family:var(--font-serif);\n    font-style:italic;\n    font-size:19px;\n    margin-bottom:18px;\n  }\n  h1{\n    font-size:clamp(46px, 6.6vw, 96px);\n    line-height:1.04;\n    font-weight:500;\n    letter-spacing:-0.028em;\n    max-width:17ch;\n  }\n\n  /* ---------- Scattered photos ---------- */\n  .tile{\n    position:absolute;\n    object-fit:cover;\n    z-index:1;\n  }\n  .tile-1{ top:-4%; left:28%; width:25%; max-width:390px; aspect-ratio:16/10; }\n  .tile-2{ top:12%; right:-5%; width:17%; min-width:200px; aspect-ratio:15/10; }\n  .tile-3{ top:32%; left:-3%; width:9.5%; min-width:110px; aspect-ratio:10/13; }\n  .tile-4{ bottom:-6%; left:-2%; width:23%; min-width:230px; aspect-ratio:16/11; }\n  .tile-5{ bottom:-10%; left:39%; width:22%; min-width:220px; aspect-ratio:16/11; }\n  .tile-6{ bottom:-4%; right:12%; width:18%; min-width:190px; aspect-ratio:14/10; }\n  .tile-7{ top:56%; right:-4%; width:10.5%; min-width:120px; aspect-ratio:10/14; }\n\n  @media (max-width:760px){\n    .nav{ padding:20px 20px; }\n    .nav-links{ display:none; }\n    .tile-1{ left:12%; width:44%; }\n    .tile-3, .tile-7{ display:none; }\n    .tile-4{ width:38%; }\n    .tile-5{ left:auto; right:-4%; width:36%; }\n    .tile-6{ display:none; }\n  }\n</style>\n\n<section class=\"hero\">\n\n  <!-- Edge-cropped studio snapshots -->\n  <img class=\"tile tile-1\" src=\"https://images.pexels.com/photos/28055999/pexels-photo-28055999.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=800\" alt=\"Hand holding a heart-eyes emoji ball above a pile of yellow smileys — victor dubugras on Pexels\" style=\"width:25%;height:auto;\" width=\"390\" height=\"244\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n  <img class=\"tile tile-2\" src=\"https://images.pexels.com/photos/19591170/pexels-photo-19591170.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=600\" alt=\"Two teammates enjoying a laugh over a craft project — Nino Sanger on Pexels\" style=\"width:17%;height:auto;\" width=\"300\" height=\"200\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n  <img class=\"tile tile-3\" src=\"https://images.unsplash.com/photo-1768471126072-ef7efb2d4939?crop=entropy&amp;cs=srgb&amp;fm=jpg&amp;ixid=M3w3NTAwNDR8MHwxfHNlYXJjaHwxfHxjcmVhdGl2ZSUyMHRlYW0lMjBsYXVnaGluZyUyMHRvZ2V0aGVyJTIwYXJvdW5kJTIwdGFibGUlMjBpbiUyMHN0dWRpbyUyMG9mZmljZSUyMGNhbmRpZHxlbnwwfHx8fDE3ODQyMTUyNjd8MA&amp;ixlib=rb-4.1.0&amp;q=85&amp;w=400\" alt=\"Designer working at a sunny desk by the window — Hanna Lazar on Unsplash\" style=\"width:9.5%;height:auto;\" width=\"140\" height=\"182\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n  <img class=\"tile tile-4\" src=\"https://images.pexels.com/photos/7413884/pexels-photo-7413884.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=700\" alt=\"Creative group cracking up around a worktable — RDNE Stock project on Pexels\" style=\"width:23%;height:auto;\" width=\"360\" height=\"248\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n  <img class=\"tile tile-5\" src=\"https://images.pexels.com/photos/4780860/pexels-photo-4780860.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=700\" alt=\"Black and white snapshots clipped to a line — julia lee on Pexels\" style=\"width:22%;height:auto;\" width=\"340\" height=\"234\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n  <img class=\"tile tile-6\" src=\"https://images.pexels.com/photos/7710151/pexels-photo-7710151.jpeg?auto=compress&amp;cs=tinysrgb&amp;w=600\" alt=\"Red-haired teammate laughing mid-meeting — Alena Darmel on Pexels\" style=\"width:18%;height:auto;\" width=\"290\" height=\"207\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n  <img class=\"tile tile-7\" src=\"https://images.unsplash.com/photo-1563279699-4c5dfcab048c?crop=entropy&amp;cs=srgb&amp;fm=jpg&amp;ixid=M3w3NTAwNDR8MHwxfHNlYXJjaHwxfHxjcmVhdGl2ZSUyMHRlYW0lMjBsYXVnaGluZyUyMHRvZ2V0aGVyJTIwYXJvdW5kJTIwdGFibGUlMjBpbiUyMHN0dWRpbyUyMG9mZmljZSUyMGNhbmRpZHxlbnwwfHx8fDE3ODQyMTUyNjd8MA&amp;ixlib=rb-4.1.0&amp;q=85&amp;w=400\" alt=\"Studio all-hands around a long table under bunting — Ryan Waring on Unsplash\" style=\"width:10.5%;height:auto;\" width=\"150\" height=\"210\" onerror=\"__crawlAsset&&__crawlAsset(this)\">\n\n  <nav class=\"nav\">\n    <a class=\"brand\" href=\"#\">Rumpus</a>\n    <div class=\"nav-links\">\n      <a class=\"nav-link\" href=\"#\">Work</a>\n      <a class=\"nav-link\" href=\"#\">Approach</a>\n      <a class=\"nav-link\" href=\"#\">Studio</a>\n      <a class=\"nav-link\" href=\"#\">Insights</a>\n      <a class=\"nav-link\" href=\"#\">Contact</a>\n      <span class=\"clock\">4:17 <sup>NYC</sup></span>\n    </div>\n  </nav>\n\n  <div class=\"center\">\n    <div class=\"eyebrow\">Studio</div>\n    <h1>We're a gang of thinkers, makers, movers, shakers, and creators</h1>\n  </div>\n</section>\n\n\n",
