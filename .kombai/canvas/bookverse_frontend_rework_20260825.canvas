n workspace\n                        </span>\n                    </div>\n                    <div class=\"ledger-preview\" data-kid=\"1-3-1-2-2-2\" data-name=\"ledger content area\">\n                        <aside class=\"ledger-rail\" data-kid=\"1-3-1-2-2-2-1\" data-name=\"ledger rail\">\n                            <div class=\"ledger-rail__brand\" data-kid=\"1-3-1-2-2-2-1-1\" data-name=\"ledger brand\">\n                                <i aria-hidden=\"true\" class=\"ti ti-book-2 icon\" data-kid=\"1-3-1-2-2-2-1-1-1\" data-name=\"ledger brand icon\">\n                                </i>\n                                <span data-kid=\"1-3-1-2-2-2-1-1-2\" data-name=\"ledger brand name\">\n                                    BookVerse\n                                </span>\n                            </div>\n                            <nav aria-label=\"Điều hướng quản trị\" class=\"ledger-nav\" data-kid=\"1-3-1-2-2-2-1-2\" data-name=\"ledger navigation menu\">\n                                <a class=\"is-active\" data-kid=\"1-3-1-2-2-2-1-2-1\" data-name=\"ledger nav link 1\" href=\"#records\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-layout-dashboard icon\" data-kid=\"1-3-1-2-2-2-1-2-1-1\" data-name=\"nav icon 1\">\n                                    </i>\n                                    Tổng quan\n                                </a>\n                                <a data-kid=\"1-3-1-2-2-2-1-2-2\" data-name=\"ledger nav link 2\" href=\"#records\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-books icon\" data-kid=\"1-3-1-2-2-2-1-2-2-1\" data-name=\"nav icon 2\">\n                                    </i>\n                                    Kho sách\n                                </a>\n                                <a data-kid=\"1-3-1-2-2-2-1-2-3\" data-name=\"ledger nav link 3\" href=\"#records\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-receipt icon\" data-kid=\"1-3-1-2-2-2-1-2-3-1\" data-name=\"nav icon 3\">\n                                    </i>\n                                    Đơn hàng\n                                </a>\n                                <a data-kid=\"1-3-1-2-2-2-1-2-4\" data-name=\"ledger nav link 4\" href=\"#records\">\n                                    <i aria-hidden=\"true\" class=\"ti ti-users icon\" data-kid=\"1-3-1-2-2-2-1-2-4-1\" data-name=\"nav icon 4\">\n                                    </i>\n                                    Người dùng\n                                </a>\n                            </nav>\n                        </aside>\n                        <div class=\"ledger-main\" data-kid=\"1-3-1-2-2-2-2\" data-name=\"ledger main area\">\n                            <div class=\"ledger-main__heading\" data-kid=\"1-3-1-2-2-2-2-1\" data-name=\"ledger main heading\">\n                                <h3 data-kid=\"1-3-1-2-2-2-2-1-1\" data-name=\"ledger main title\">\n                                    Tổng quan hệ thống\n                                </h3>\n                                <span data-kid=\"1-3-1-2-2-2-2-1-2\" data-name=\"ledger period date\">\n                                    08 / 2026\n                                </span>\n                            </div>\n                            <div class=\"metric-strip\" data-kid=\"1-3-1-2-2-2-2-2\" data-name=\"metric strip\">\n                                <div class=\"metric-cell metric-cell--revenue\" data-kid=\"1-3-1-2-2-2-2-2-1\" data-name=\"revenue cell\">\n                                    <div class=\"metric-cell__label\" data-kid=\"1-3-1-2-2-2-2-2-1-1\" data-name=\"revenue label\">\n                                        Doanh thu tháng\n                                    </div>\n                                    <div class=\"metric-cell__value\" data-kid=\"1-3-1-2-2-2-2-2-1-2\" data-name=\"revenue value\">\n                                        0 ₫\n                                    </div>\n                                </div>\n                                <div class=\"metric-cell\" data-kid=\"1-3-1-2-2-2-2-2-2\" data-name=\"daily revenue cell\">\n                                    <div class=\"metric-cell__label\" data-kid=\"1-3-1-2-2-2-2-2-2-1\" data-name=\"daily revenue label\">\n                                        Doanh thu hôm nay\n                                    </div>\n                                    <div class=\"metric-cell__value\" data-kid=\"1-3-1-2-2-2-2-2-2-2\" data-name=\"daily revenue value\">\n                                        0 ₫\n                                    </div>\n                                </div>\n                                <div class=\"metric-cell\" data-kid=\"1-3-1-2-2-2-2-2-3\" data-name=\"order count cell\">\n                                    <div class=\"metric-cell__label\" data-kid=\"1-3-1-2-2-2-2-2-3-1\" data-name=\"order count label\">\n                                        Tổng đơn\n                                    </div>\n                                    <div class=\"metric-cell__value\" data-kid=\"1-3-1-2-2-2-2-2-3-2\" data-name=\"order count value\">\n                                        0\n                                    </div>\n                                </div>\n                                <div class=\"metric-cell metric-cell--pending\" data-kid=\"1-3-1-2-2-2-2-2-4\" data-name=\"pending cell\">\n                                    <div class=\"metric-cell__label\" data-kid=\"1-3-1-2-2-2-2-2-4-1\" data-name=\"pending label\">\n                                        Chờ xử lý\n                                    </div>\n                                    <div class=\"metric-cell__value\" data-kid=\"1-3-1-2-2-2-2-2-4-2\" data-name=\"pending value\">\n                                        0\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"recent-orders\" data-kid=\"1-3-1-2-2-2-2-3\" data-name=\"recent orders list\">\n                                <div class=\"recent-orders__label\" data-kid=\"1-3-1-2-2-2-2-3-1\" data-name=\"recent orders label\">\n                                    Đơn hàng mới nhất\n                                </div>\n                                <table class=\"ledger-table\" data-kid=\"1-3-1-2-2-2-2-3-2\" data-name=\"ledger table\">\n                                    <thead data-kid=\"1-3-1-2-2-2-2-3-2-1\" data-name=\"table head\">\n                                        <tr data-kid=\"1-3-1-2-2-2-2-3-2-1-1\" data-name=\"head row\">\n                                            <th data-kid=\"1-3-1-2-2-2-2-3-2-1-1-1\" data-name=\"head cell 1\">\n                                                Mã đơn\n                                            </th>\n                                            <th data-kid=\"1-3-1-2-2-2-2-3-2-1-1-2\" data-name=\"head cell 2\">\n                                                Khách hàng\n                                            </th>\n                                            <th data-kid=\"1-3-1-2-2-2-2-3-2-1-1-3\" data-name=\"head cell 3\">\n                                                Tổng tiền\n                                            </th>\n                                            <th data-kid=\"1-3-1-2-2-2-2-3-2-1-1-4\" data-name=\"head cell 4\">\n                                                Trạng thái\n                                            </th>\n                                        </tr>\n                                    </thead>\n                                    <tbody data-kid=\"1-3-1-2-2-2-2-3-2-2\" data-name=\"table body\">\n                                        <tr data-kid=\"1-3-1-2-2-2-2-3-2-2-1\" data-name=\"table row 1\">\n                                            <td class=\"number\" data-kid=\"1-3-1-2-2-2-2-3-2-2-1-1\" data-name=\"row 1 cell 1\">\n                                                —\n                                            </td>\n                                            <td data-kid=\"1-3-1-2-2-2-2-3-2-2-1-2\" data-name=\"row 1 cell 2\">\n                                                Chưa có đơn\n                                            </td>\n                                            <td class=\"number\" data-kid=\"1-3-1-2-2-2-2-3-2-2-1-3\" data-name=\"row 1 cell 3\">\n                                                0 ₫\n                                            </td>\n                                            <td class=\"table-status--pending\" data-kid=\"1-3-1-2-2-2-2-3-2-2-1-4\" data-name=\"row 1 cell 4 status\">\n                                                Chờ xử lý\n                                            </td>\n                                        </tr>\n                                        <tr data-kid=\"1-3-1-2-2-2-2-3-2-2-2\" data-name=\"table row 2\">\n                                            <td class=\"number\" data-kid=\"1-3-1-2-2-2-2-3-2-2-2-1\" data-name=\"row 2 cell 1\">\n                                                —\n                                            </td>\n                                            <td data-kid=\"1-3-1-2-2-2-2-3-2-2-2-2\" data-name=\"row 2 cell 2\">\n                                                —\n                                            </td>\n                                            <td class=\"number\" data-kid=\"1-3-1-2-2-2-2-3-2-2-2-3\" data-name=\"row 2 cell 3\">\n                                                —\n                                            </td>\n                                            <td class=\"table-status\" data-kid=\"1-3-1-2-2-2-2-3-2-2-2-4\" data-name=\"row 2 cell 4 status\">\n                                                —\n                                            </td>\n                                        </tr>\n                                    </tbody>\n                                </table>\n                            </div>\n                        </div>\n                    </div>\n                </article>\n            </div>\n        </div>\n    </section>\n    <footer class=\"site-footer\" data-kid=\"1-4\" data-name=\"site footer\">\n        <div class=\"bv-shell site-footer__inner\" data-kid=\"1-4-1\" data-name=\"footer inner container\">\n            <span class=\"site-footer__brand\" data-kid=\"1-4-1-1\" data-name=\"footer brand name\">\n                BookVerse\n            </span>\n            <span data-kid=\"1-4-1-2\" data-name=\"copyright text\">\n                © 2026 BookVerse · Catalog, record, ledger.\n            </span>\n        </div>\n    </footer>\n</div>\n<script>\n    const menuButton = document.querySelector('.menu-toggle');\n  const customerNav = document.getElementById('customer-nav');\n  if (menuButton && customerNav) {\n    menuButton.addEventListener('click', () => {\n      const isOpen = customerNav.classList.toggle('is-open');\n      menuButton.setAttribute('aria-expanded', String(isOpen));\n      menuButton.innerHTML = isOpen ? '<i class=\"ti ti-x icon\" aria-hidden=\"true\"></i>' : '<i class=\"ti ti-menu-2 icon\" aria-hidden=\"true\"></i>';\n    });\n  }\n  const filterButton = document.querySelector('.filter-trigger');\n  const filterPanel = document.getElementById('catalog-filters');\n  if (filterButton && filterPanel) {\n    filterButton.addEventListener('click', () => {\n      const isOpen = filterPanel.classList.toggle('is-open');\n      filterButton.setAttribute('aria-expanded', String(isOpen));\n    });\n  }\n</script>\n",
      "comments": [],
      "created": "2026-08-25T11:56:36.054991+00:00",
      "modified": "2026-08-25T11:58:23.267192+00:00",
      "id": "var_31458d2f169c"
    },
    "var_2ef774319fde": {
      "type": "variant",
      "label": "BookVerse — Bookshop Counter",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 1380,
        "y": 0,
        "w": 1280,
        "h": 800
      },
      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:wght@500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --paper: #FBF3EC;\n    --paper-warm: #F4E8DC;\n    --paper-dark: #EAD8C7;\n    --surface: #FFFFFF;\n    --ink: #2B2140;\n    --ink-secondary: #584B6E;\n    --ink-muted: #8E82A2;\n    --border: #E8DACB;\n    --marigold: #E28725;\n    --marigold-bg: #FEF3E6;\n    --coral: #D94A3D;\n    --coral-bg: #FDEEED;\n    --sage: #287C68;\n    --sage-bg: #E8F5F1;\n    --lavender: #6A4BC4;\n    --lavender-bg: #F1EDFC;\n    --radius-sm: 6px;\n    --radius-md: 12px;\n    --font-heading: 'Lora', Georgia, serif;\n    --font-body: 'Be Vietnam Pro', Arial, sans-serif;\n    --font-number: 'Space Grotesk', 'Courier New', monospace;\n  }\n\n  body {\n    margin: 0;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: var(--font-body);\n    line-height: 1.5;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  .bv-screen { min-height: 100vh; background: var(--paper); }\n  .bv-container { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }\n  .font-heading { font-family: var(--font-heading); }\n  .font-number { font-family: var(--font-number); font-variant-numeric: tabular-nums; }\n  .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }\n  .ti { line-height: 1; }\n\n  .site-header {\n    min-height: 64px;\n    background: var(--paper);\n    border-bottom: 1px solid var(--border);\n    display: flex;\n    align-items: center;\n  }\n  .header-row {\n    display: grid;\n    grid-template-columns: 184px minmax(320px, 1fr) auto;\n    gap: 24px;\n    align-items: center;\n  }\n  .brand {\n    display: inline-flex;\n    align-items: center;\n    gap: 10px;\n    color: var(--ink);\n    text-decoration: none;\n    white-space: nowrap;\n  }\n  .brand-mark {\n    width: 32px;\n    height: 32px;\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    color: var(--paper);\n    background: var(--ink);\n    border-radius: var(--radius-sm);\n    font-size: 18px;\n  }\n  .brand-name { font: 700 21px/1 var(--font-heading); letter-spacing: -0.3px; }\n  .global-search {\n    height: 40px;\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: var(--radius-sm);\n    padding: 0 13px;\n    color: var(--ink-muted);\n  }\n  .global-search:focus-within { border-color: var(--ink); outline: 3px solid rgba(43,33,64,.10); outline-offset: 2px; }\n  .global-search input {\n    width: 100%;\n    min-width: 0;\n    border: 0;\n    outline: 0;\n    background: transparent;\n    color: var(--ink);\n    font: 500 13px var(--font-body);\n  }\n  .global-search input::placeholder { color: var(--ink-muted); }\n  .header-actions { display: flex; align-items: center; justify-content: flex-end; gap: 10px; }\n  .home-link {\n    color: var(--ink-secondary);\n    font-size: 13px;\n    font-weight: 600;\n    text-decoration: none;\n    padding: 8px 2px;\n    white-space: nowrap;\n  }\n  .home-link:hover, .home-link:focus-visible { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; }\n  .header-action {\n    min-height: 40px;\n    display: inline-flex;\n    align-items: center;\n    gap: 8px;\n    padding: 0 12px;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-sm);\n    color: var(--ink-secondary);\n    background: transparent;\n    font: 600 12px var(--font-body);\n    text-decoration: none;\n    white-space: nowrap;\n  }\n  .header-action:hover, .header-action:focus-visible { border-color: var(--ink); color: var(--ink); outline: 3px solid rgba(43,33,64,.10); outline-offset: 2px; }\n  .header-action.primary { background: var(--ink); color: var(--paper); border-color: var(--ink); }\n  .header-action.primary:hover, .header-action.primary:focus-visible { background: #3c2f56; }\n  .cart-count { color: var(--marigold); font-family: var(--font-number); }\n\n  .catalog-masthead { padding: 38px 0 30px; border-bottom: 1px solid var(--border); }\n  .masthead-row { display: grid; grid-template-columns: minmax(0, .9fr) minmax(440px, 1.1fr); gap: 56px; align-items: end; }\n  .eyebrow { color: var(--ink-muted); font: 700 11px/1 var(--font-number); letter-spacing: .12em; text-transform: uppercase; margin-bottom: 12px; }\n  .masthead-title { max-width: 500px; margin: 0; font: 600 34px/1.18 var(--font-heading); letter-spacing: -0.6px; }\n  .masthead-copy { max-width: 470px; margin: 12px 0 0; color: var(--ink-secondary); font-size: 14px; }\n  .query-panel { display: grid; grid-template-columns: 1fr 148px; gap: 10px; align-items: end; }\n  .query-field { display: grid; gap: 7px; }\n  .field-label { color: var(--ink-secondary); font-size: 11px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; }\n  .query-input, .sort-select, .filter-input {\n    height: 42px;\n    border: 1px solid var(--border);\n    border-radius: var(--radius-sm);\n    background: var(--surface);\n    color: var(--ink);\n    font: 500 13px var(--font-body);\n    padding: 0 12px;\n  }\n  .query-input { width: 100%; box-sizing: border-box; }\n  .query-input:focus, .sort-select:focus, .filter-input:focus { outline: 3px solid rgba(43,33,64,.12); outline-offset: 2px; border-color: var(--ink); }\n  .sort-field { display: grid; gap: 7px; }\n  .sort-select { width: 100%; }\n\n  .catalog-content { padding: 28px 0 54px; }\n  .catalog-line { display: flex; align-items: baseline; justify-content: space-between; gap: 20px; margin-bottom: 17px; }\n  .catalog-title { margin: 0; font: 600 22px/1.2 var(--font-heading); }\n  .result-count { margin: 4px 0 0; color: var(--ink-secondary); font-size: 12px; }\n  .catalog-tools { display: inline-flex; align-items: center; gap: 9px; color: var(--ink-secondary); font-size: 12px; }\n  .catalog-tools .ti { font-size: 16px; color: var(--ink-muted); }\n\n  .filter-ledger {\n    display: flex;\n    align-items: stretch;\n    border-top: 1px solid var(--border);\n    border-bottom: 1px solid var(--border);\n    margin-bottom: 24px;\n    min-height: 74px;\n  }\n  .filter-group { padding: 13px 20px 13px 0; margin-right: 20px; border-right: 1px solid var(--border); display: flex; flex-direction: column; justify-content: center; gap: 9px; }\n  .filter-group:first-child { min-width: 220px; }\n  .filter-group:last-of-type { border-right: 0; }\n  .filter-name { color: var(--ink-muted); font: 700 10px/1 var(--font-number); letter-spacing: .10em; text-transform: uppercase; }\n  .category-options { display: flex; align-items: center; gap: 17px; }\n  .category-option { border: 0; padding: 0 0 4px; position: relative; background: transparent; color: var(--ink-secondary); cursor: pointer; font: 600 12px var(--font-body); }\n  .category-option.active { color: var(--ink); }\n  .category-option.active::before { content: ''; position: absolute; width: 2px; height: 15px; background: var(--ink); left: -8px; top: 1px; }\n  .category-option:hover, .category-option:focus-visible { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; outline: 0; }\n  .range-fields { display: flex; align-items: center; gap: 7px; }\n  .filter-input { width: 76px; height: 32px; padding: 0 9px; background: var(--paper); font-size: 12px; }\n  .range-dash { color: var(--ink-muted); }\n  .year-input { width: 86px; }\n  .reset-button { align-self: center; margin-left: auto; border: 0; background: transparent; color: var(--ink-secondary); font: 600 12px var(--font-body); cursor: pointer; text-decoration: underline; text-underline-offset: 4px; }\n  .reset-button:hover, .reset-button:focus-visible { color: var(--ink); outline: 3px solid rgba(43,33,64,.10); outline-offset: 4px; }\n  .active-filters { display: flex; align-items: center; gap: 7px; flex-wrap: wrap; margin: -13px 0 23px; min-height: 20px; }\n  .active-filter { display: inline-flex; align-items: center; gap: 7px; border: 1px solid var(--lavender); border-radius: 4px; padding: 4px 7px; color: var(--lavender); background: var(--lavender-bg); font: 600 11px var(--font-body); }\n  .active-filter button { border: 0; background: transparent; color: currentColor; cursor: pointer; padding: 0; font-size: 13px; }\n\n  .shelf-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; align-items: start; }\n  .book-tile {\n    position: relative;\n    display: grid;\n    grid-template-columns: 76px minmax(0, 1fr);\n    gap: 13px;\n    min-height: 164px;\n    padding: 13px;\n    background: var(--surface);\n    border: 1px solid var(--border);\n    border-radius: var(--radius-md);\n  }\n  .book-tile:hover { border-color: var(--ink); }\n  .book-tile:hover .book-title { text-decoration: underline; text-underline-offset: 3px; }\n  .book-tile::before { content: ''; position: absolute; left: -1px; top: 18px; height: 28px; width: 2px; background: transparent; }\n  .book-tile:hover::before { background: var(--ink); }\n  .cover {\n    width: 76px;\n    height: 112px;\n    border-radius: 4px;\n    overflow: hidden;\n    border: 1px solid var(--paper-dark);\n    background: var(--paper-warm);\n    display: flex;\n    align-items: center;\n    justify-content: center;\n    flex-shrink: 0;\n  }\n  .cover img { width: 100%; height: 100%; object-fit: cover; display: block; }\n  .cover-fallback { height: 100%; width: 100%; padding: 8px; box-sizing: border-box; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 7px; color: var(--ink-secondary); text-align: center; }\n  .cover-fallback .ti { color: var(--ink-muted); font-size: 22px; }\n  .cover-fallback span { font: 700 9px/1.25 var(--font-number); letter-spacing: .06em; text-transform: uppercase; }\n  .book-info { min-width: 0; display: flex; flex-direction: column; min-height: 138px; }\n  .book-kicker { min-height: 17px; display: flex; align-items: center; gap: 6px; color: var(--ink-muted); font: 700 9px/1 var(--font-number); letter-spacing: .08em; text-transform: uppercase; }\n  .status-dot { width: 6px; height: 6px; display: inline-block; border-radius: 50%; background: var(--sage); }\n  .status-dot.out { background: var(--coral); }\n  .book-title { margin: 8px 0 3px; color: var(--ink); font: 600 15px/1.25 var(--font-heading); }\n  .book-author { color: var(--ink-secondary); font-size: 11px; line-height: 1.35; }\n  .book-meta { display: flex; gap: 10px; margin-top: 8px; color: var(--ink-muted); font: 500 10px var(--font-number); }\n  .rating { color: var(--marigold); }\n  .tile-bottom { margin-top: auto; padding-top: 11px; display: flex; align-items: center; justify-content: space-between; gap: 7px; border-top: 1px solid var(--border); }\n  .book-price { color: var(--ink); font: 700 15px var(--font-number); white-space: nowrap; }\n  .book-actions { display: flex; align-items: center; justify-content: flex-end; gap: 5px; }\n  .icon-button, .text-button { min-height: 32px; display: inline-flex; align-items: center; justify-content: center; border-radius: 4px; cursor: pointer; }\n  .icon-button { width: 32px; padding: 0; border: 1px solid var(--border); background: var(--surface); color: var(--ink-muted); }\n  .icon-button:hover, .icon-button:focus-visible { border-color: var(--ink); color: var(--ink); outline: 3px solid rgba(43,33,64,.10); outline-offset: 2px; }\n  .text-button { padding: 0 9px; border: 1px solid var(--ink); background: var(--ink); color: var(--paper); font: 600 10px var(--font-body); white-space: nowrap; }\n  .text-button:hover, .text-button:focus-visible { background: #3c2f56; outline: 3px solid rgba(43,33,64,.10); outline-offset: 2px; }\n  .text-button:disabled { cursor: not-allowed; border-color: var(--border); background: var(--paper-warm); color: var(--ink-muted); }\n\n  .transaction-preview { margin-top: 45px; border-top: 1px solid var(--border); padding-top: 22px; display: grid; grid-template-columns: 1fr 1.5fr; gap: 34px; align-items: center; }\n  .transaction-heading { margin: 0 0 5px; font: 600 18px/1.2 var(--font-heading); }\n  .transaction-copy { margin: 0; max-width: 350px; color: var(--ink-secondary); font-size: 12px; }\n  .transaction-box { display: grid; grid-template-columns: 1fr 190px; gap: 22px; align-items: center; padding: 17px 0; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }\n  .transaction-spine { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }\n  .transaction-stage { position: relative; min-height: 45px; padding-left: 17px; border-left: 1px solid var(--border); display: flex; flex-direction: column; justify-content: center; gap: 4px; }\n  .transaction-stage:first-child { border-left: 0; }\n  .transaction-stage.active::before, .transaction-stage.complete::before { content: ''; position: absolute; left: -1px; top: 0; width: 2px; height: 28px; background: var(--marigold); }\n  .transaction-stage.complete::before { background: var(--sage); }\n  .stage-index { color: var(--ink-muted); font: 700 10px var(--font-number); }\n  .stage-name { color: var(--ink-secondary); font-size: 12px; font-weight: 600; }\n  .transaction-stage.active .stage-name { color: var(--ink); }\n  .receipt-total { padding-left: 22px; border-left: 1px solid var(--border); }\n  .receipt-label { color: var(--ink-muted); font: 700 10px var(--font-number); letter-spacing: .08em; text-transform: uppercase; }\n  .receipt-value { margin-top: 3px; color: var(--ink); font: 700 24px var(--font-number); }\n  .receipt-note { margin-top: 4px; color: var(--sage); font-size: 11px; }\n  .receipt-link { display: inline-flex; align-items: center; gap: 5px; margin-top: 10px; color: var(--ink); font-size: 11px; font-weight: 700; text-decoration: none; }\n  .receipt-link:hover, .receipt-link:focus-visible { text-decoration: underline; text-underline-offset: 4px; outline: 0; }\n\n  .site-footer { border-top: 1px solid var(--border); padding: 20px 0 24px; background: var(--paper-warm); }\n  .footer-row { display: flex; justify-content: space-between; align-items: center; gap: 20px; color: var(--ink-muted); font-size: 11px; }\n  .footer-brand { display: inline-flex; align-items: center; gap: 7px; color: var(--ink); font: 600 14px var(--font-heading); }\n  .footer-brand .ti { font-size: 16px; }\n  .footer-links { display: flex; align-items: center; gap: 18px; }\n  .footer-links a { color: var(--ink-secondary); text-decoration: none; }\n  .footer-links a:hover, .footer-links a:focus-visible { color: var(--ink); text-decoration: underline; text-underline-offset: 4px; outline: 0; }\n\n  @media (max-width: 980px) {\n    .bv-container { width: min(100% - 40px, 720px); }\n    .header-row { grid-template-columns: auto 1fr auto; gap: 14px; }\n    .global-search { order: 4; grid-column: 1 / -1; margin-bottom: 12px; }\n    .site-header { padding: 11px 0 0; }\n    .masthead-row { grid-template-columns: 1fr; gap: 22px; }\n    .shelf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }\n    .filter-ledger { overflow-x: auto; }\n    .filter-group { flex-shrink: 0; }\n  }\n\n  @media (max-width: 560px) {\n    .bv-container { width: calc(100% - 28px); }\n    .header-row { grid-template-columns: 1fr auto; }\n    .brand-name { font-size: 19px; }\n    .home-link { display: none; }\n    .header-actions { gap: 6px; }\n    .header-action { padding: 0 9px; }\n    .header-action span:not(.cart-count) { display: none; }\n    .header-action .ti { font-size: 17px; }\n    .header-action.primary { min-width: 40px; }\n    .catalog-masthead { padding: 28px 0 22px; }\n    .masthead-title { font-size: 28px; }\n    .masthead-copy { font-size: 13px; }\n    .query-panel { grid-template-columns: 1fr; gap: 10px; }\n    .catalog-content { padding-top: 22px; }\n    .catalog-line { align-items: flex-start; margin-bottom: 13px; }\n    .catalog-title { font-size: 20px; }\n    .catalog-tools { white-space: nowrap; }\n    .filter-ledger { margin-bottom: 16px; min-height: 66px; }\n    .filter-group { padding-right: 16px; margin-right: 16px; }\n    .filter-group:first-child { min-width: 200px; }\n    .reset-button { margin-left: 0; padding: 0 14px 0 0; flex-shrink: 0; }\n    .active-filters { flex-wrap: nowrap; overflow-x: auto; margin-top: -6px; padding-bottom: 10px; }\n    .active-filter { flex-shrink: 0; }\n    .shelf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 9px; }\n    .book-tile { grid-template-columns: 1fr; gap: 9px; padding: 9px; min-height: 0; }\n    .cover { width: 100%; height: auto; aspect-ratio: 2 / 3; }\n    .book-info { min-height: 0; }\n    .book-kicker { font-size: 8px; }\n    .book-title { font-size: 14px; }\n    .book-author { font-size: 10px; }\n    .book-meta { margin-top: 6px; gap: 7px; }\n    .tile-bottom { align-items: flex-end; padding-top: 9px; }\n    .book-price { font-size: 13px; }\n    .book-actions { gap: 4px; }\n    .icon-button { width: 30px; min-height: 30px; }\n    .text-button { min-height: 30px; padding: 0 7px; font-size: 9px; }\n    .transaction-preview { grid-template-columns: 1fr; gap: 17px; margin-top: 30px; padding-top: 17px; }\n    .transaction-box { grid-template-columns: 1fr; gap: 18px; }\n    .receipt-total { padding: 14px 0 0; border-left: 0; border-top: 1px solid var(--border); }\n    .footer-row { align-items: flex-start; flex-direction: column; gap: 12px; }\n    .footer-links { gap: 12px; flex-wrap: wrap; }\n  }\n\n  @media (max-width: 390px) {\n    .header-action { min-height: 36px; }\n    .masthead-title { font-size: 26px; }\n    .book-title { font-size: 13px; }\n    .book-price { font-size: 12px; }\n    .text-button { padding: 0 6px; }\n  }\n</style>\n<div class=\"bv-screen\" data-kid=\"1\">\n    <header class=\"site-header\" data-kid=\"1-1\">\n        <div class=\"bv-container header-row\" data-kid=\"1-1-1\">\n            <a aria-label=\"BookVerse — Trang chủ\" class=\"brand\" data-kid=\"1-1-1-1\" data-name=\"brand link\" href=\"#catalog\">\n                <span aria-hidden=\"true\" class=\"brand-mark\" data-kid=\"1-1-1-1-1\" data-name=\"brand icon container\">\n                    <i class=\"ti ti-book-2\" data-kid=\"1-1-1-1-1-1\" data-name=\"book icon\">\n                    </i>\n                </span>\n                <span class=\"brand-name\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    BookVerse\n                </span>\n            </a>\n            <label class=\"global-search\" data-kid=\"1-1-1-2\" data-name=\"global search wrapper\">\n                <i aria-hidden=\"true\" class=\"ti ti-search\" data-kid=\"1-1-1-2-1\" data-name=\"search icon\">\n                </i>\n                <span class=\"sr-only\" data-kid=\"1-1-1-2-2\" data-name=\"search label sr only text\">\n                    Tìm kiếm sách\n                </span>\n                <input data-kid=\"1-1-1-2-3\" data-name=\"search input field\" placeholder=\"Tìm theo tên sách, tác giả, mã ISBN...\" type=\"search\"/>\n            </label>\n            <div class=\"header-actions\" data-kid=\"1-1-1-3\" data-name=\"header actions wrapper\">\n                <a class=\"home-link\" data-kid=\"1-1-1-3-1\" data-name=\"home link\" href=\"#catalog\">\n                    Trang chủ\n                </a>\n                <a class=\"header-action\" data-kid=\"1-1-1-3-2\" data-name=\"login button\" href=\"#account\">\n                    <i aria-hidden=\"true\" class=\"ti ti-user\" data-kid=\"1-1-1-3-2-1\" data-name=\"login icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-2-2\" data-name=\"login text\">\n                        Đăng nhập\n                    </span>\n                </a>\n                <a aria-label=\"Giỏ hàng, 0 sản phẩm\" class=\"header-action primary\" data-kid=\"1-1-1-3-3\" data-name=\"cart link\" href=\"#cart\">\n                    <i aria-hidden=\"true\" class=\"ti ti-shopping-cart\" data-kid=\"1-1-1-3-3-1\" data-name=\"cart icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-3-2\" data-name=\"cart text\">\n                        Giỏ hàng\n                    </span>\n                    <span class=\"cart-count\" data-dynamic=\"true\" data-kid=\"1-1-1-3-3-3\" data-name=\"cart item count\" data-reason=\"value updated by shopping cart script\">\n                        0\n                    </span>\n                </a>\n            </div>\n        </div>\n    </header>\n    <main data-kid=\"1-2\" data-name=\"main content area\" id=\"catalog\">\n        <section class=\"catalog-masthead\" data-kid=\"1-2-1\" data-name=\"catalog masthead section\">\n            <div class=\"bv-container masthead-row\" data-kid=\"1-2-1-1\" data-name=\"masthead container\">\n                <div data-kid=\"1-2-1-1-1\" data-name=\"masthead intro text container\">\n                    <div class=\"eyebrow\" data-kid=\"1-2-1-1-1-1\" data-name=\"masthead eyebrow text\">\n                        Danh mục sách\n                    </div>\n                    <h1 class=\"masthead-title\" data-kid=\"1-2-1-1-1-2\" data-name=\"masthead title\">\n                        Đắm mình vào từng trang sách hay\n                    </h1>\n                    <p class=\"masthead-copy\" data-kid=\"1-2-1-1-1-3\" data-name=\"masthead copy text\">\n                        Tuyển tập tác phẩm từ văn học, kinh tế, công nghệ đến kỹ năng sống — tìm đúng cuốn sách cho lần đọc tiếp theo.\n                    </p>\n                </div>\n                <div aria-label=\"Tìm kiếm và sắp xếp danh mục\" class=\"query-panel\" data-kid=\"1-2-1-1-2\" data-name=\"catalog query panel\">\n                    <label class=\"query-field\" data-kid=\"1-2-1-1-2-1\" data-name=\"query search field\">\n                        <span class=\"field-label\" data-kid=\"1-2-1-1-2-1-1\" data-name=\"query field label\">\n                            Tìm kiếm trong danh mục\n                        </span>\n                        <input class=\"query-input\" data-kid=\"1-2-1-1-2-1-2\" data-name=\"query search input\" placeholder=\"Tên sách, tác giả hoặc ISBN...\" type=\"search\"/>\n                    </label>\n                    <label class=\"sort-field\" data-kid=\"1-2-1-1-2-2\" data-name=\"query sort field\">\n                        <span class=\"field-label\" data-kid=\"1-2-1-1-2-2-1\" data-name=\"sort field label\">\n                            Sắp xếp\n                        </span>\n                        <select class=\"sort-select\" data-kid=\"1-2-1-1-2-2-2\" data-name=\"sort dropdown select\">\n                            <option data-kid=\"1-2-1-1-2-2-2-1\" data-name=\"sort option 1\">\n                                Tên A → Z\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-2-2\" data-name=\"sort option 2\">\n                                Tên Z → A\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-2-3\" data-name=\"sort option 3\">\n                                Đánh giá cao nhất\n                            </option>\n                            <option data-kid=\"1-2-1-1-2-2-2-4\" data-name=\"sort option 4\">\n                                Mới xuất bản\n                            </option>\n                        </select>\n                    </label>\n                </div>\n            </div>\n        </section>\n        <section class=\"catalog-content\" data-kid=\"1-2-2\" data-name=\"catalog content section\">\n            <div class=\"bv-container\" data-kid=\"1-2-2-1\" data-name=\"catalog container\">\n                <div class=\"catalog-line\" data-kid=\"1-2-2-1-1\" data-name=\"catalog header line\">\n                    <div data-kid=\"1-2-2-1-1-1\" data-name=\"catalog title container\">\n               