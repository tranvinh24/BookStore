      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:wght@500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --paper: #FBF3EC;\n    --paper-card: #FFFFFF;\n    --paper-warm: #F4E8DC;\n    --paper-dark: #EAD8C7;\n    --ink: #2B2140;\n    --ink-secondary: #584B6E;\n    --ink-muted: #8E82A2;\n    --border: #E8DACB;\n    --ribbon-marigold: #E28725;\n    --ribbon-marigold-bg: #FEF3E6;\n    --ribbon-coral: #D94A3D;\n    --ribbon-coral-bg: #FDEEED;\n    --ribbon-sage: #287C68;\n    --ribbon-sage-bg: #E8F5F1;\n    --ribbon-lavender: #6A4BC4;\n    --ribbon-lavender-bg: #F1EDFC;\n    --font-heading: 'Lora', Georgia, serif;\n    --font-body: 'Be Vietnam Pro', 'Segoe UI', sans-serif;\n    --font-number: 'Space Grotesk', 'Segoe UI', sans-serif;\n    --radius-sm: 6px;\n    --radius-md: 10px;\n  }\n\n  body {\n    margin: 0;\n    background: var(--paper);\n    color: var(--ink);\n    font-family: var(--font-body);\n    -webkit-font-smoothing: antialiased;\n  }\n  .bv-page { min-height: 100vh; background: var(--paper); }\n  .bv-shell { max-width: 1200px; margin: 0 auto; padding: 0 32px; }\n  .font-heading { font-family: var(--font-heading); }\n  .font-number { font-family: var(--font-number); font-variant-numeric: tabular-nums; }\n  .muted { color: var(--ink-secondary); }\n  .quiet { color: var(--ink-muted); }\n  .icon { display: inline-block; line-height: 1; font-size: 18px; color: currentColor; }\n  .eyebrow { color: var(--ink-muted); font-size: 11px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; }\n\n  .library-rail {\n    height: 64px;\n    border-bottom: 1px solid var(--border);\n    background: rgba(251, 243, 236, .98);\n  }\n  .rail-inner { height: 100%; display: flex; align-items: center; justify-content: space-between; gap: 24px; }\n  .brand-mark { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); white-space: nowrap; }\n  .brand-mark .icon { color: var(--ribbon-marigold); font-size: 22px; }\n  .brand-name { font-family: var(--font-heading); font-weight: 700; font-size: 22px; letter-spacing: -.02em; }\n  .task-nav { display: flex; align-items: center; gap: 25px; height: 100%; }\n  .task-nav a { position: relative; display: inline-flex; align-items: center; height: 100%; color: var(--ink-secondary); font-size: 13px; font-weight: 600; text-decoration: none; }\n  .task-nav a:hover, .task-nav a.active { color: var(--ink); }\n  .task-nav a.active::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; background: var(--ink); }\n  .rail-actions { display: flex; align-items: center; gap: 10px; }\n  .text-action, .outline-action { border: 0; background: transparent; color: var(--ink-secondary); font: 600 13px var(--font-body); cursor: pointer; text-decoration: none; }\n  .outline-action { border: 1px solid var(--border); border-radius: var(--radius-sm); padding: 9px 14px; color: var(--ink); background: var(--paper-card); }\n  .primary-action { display: inline-flex; align-items: center; justify-content: center; gap: 8px; border: 1px solid var(--ink); border-radius: var(--radius-sm); padding: 10px 15px; background: var(--ink); color: var(--paper); font: 700 13px var(--font-body); cursor: pointer; }\n  .primary-action:hover { background: #3a2b56; }\n\n  .masthead { background: var(--paper-warm); border-bottom: 1px solid var(--border); }\n  .masthead-inner { display: grid; grid-template-columns: minmax(0, 1.04fr) minmax(420px, .96fr); gap: 72px; align-items: center; padding: 52px 32px 48px; }\n  .masthead-copy h1 { max-width: 560px; margin: 0; color: var(--ink); font: 600 42px/1.14 var(--font-heading); letter-spacing: -.035em; }\n  .masthead-copy p { max-width: 520px; margin: 18px 0 0; color: var(--ink-secondary); font-size: 15px; line-height: 1.7; }\n  .masthead-rule { width: 52px; height: 3px; margin-bottom: 18px; background: var(--ribbon-marigold); }\n  .search-plate { background: var(--paper-card); border: 1px solid var(--border); padding: 20px; }\n  .search-plate-label { display: flex; align-items: center; justify-content: space-between; margin-bottom: 10px; }\n  .search-plate-label span:last-child { color: var(--ink-muted); font: 600 12px var(--font-number); }\n  .search-form { display: flex; align-items: stretch; gap: 10px; }\n  .search-field { position: relative; flex: 1; }\n  .search-field .icon { position: absolute; top: 50%; left: 14px; transform: translateY(-50%); color: var(--ink-muted); }\n  .search-field input { width: 100%; height: 46px; box-sizing: border-box; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--paper); color: var(--ink); padding: 0 14px 0 42px; font: 400 14px var(--font-body); outline: none; }\n  .search-field input:focus { border-color: var(--ink); box-shadow: 0 0 0 3px rgba(43,33,64,.09); }\n  .search-submit { min-width: 108px; border: 1px solid var(--ink); border-radius: var(--radius-sm); background: var(--ink); color: var(--paper); font: 700 13px var(--font-body); cursor: pointer; }\n  .search-submit:hover { background: #3a2b56; }\n  .search-hint { display: flex; justify-content: space-between; gap: 14px; margin-top: 12px; color: var(--ink-muted); font-size: 11px; }\n\n  .catalog-section { padding: 32px 32px 0; }\n  .index-line { display: flex; align-items: flex-end; justify-content: space-between; gap: 24px; padding-bottom: 22px; border-bottom: 1px solid var(--border); }\n  .index-title { margin: 0; font: 600 25px/1.2 var(--font-heading); letter-spacing: -.02em; }\n  .index-count { margin: 6px 0 0; color: var(--ink-secondary); font-size: 13px; }\n  .index-tools { display: flex; align-items: center; gap: 14px; }\n  .sort-label { color: var(--ink-muted); font-size: 12px; font-weight: 700; }\n  .sort-select { border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--paper-card); color: var(--ink); padding: 10px 32px 10px 12px; font: 600 13px var(--font-body); }\n  .filter-trigger { display: none; border: 1px solid var(--border); border-radius: var(--radius-sm); background: transparent; color: var(--ink); padding: 10px 12px; font: 700 13px var(--font-body); }\n\n  .catalog-layout { display: grid; grid-template-columns: 228px minmax(0, 1fr); gap: 30px; padding: 28px 0 50px; }\n  .filter-rail { border-right: 1px solid var(--border); padding-right: 24px; }\n  .filter-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 22px; }\n  .filter-heading h2 { margin: 0; font: 700 14px var(--font-body); }\n  .reset-link { border: 0; background: none; color: var(--ribbon-lavender); font: 600 12px var(--font-body); cursor: pointer; }\n  .filter-group { padding: 0 0 21px; margin-bottom: 21px; border-bottom: 1px solid var(--border); }\n  .filter-group:last-child { margin-bottom: 0; border-bottom: 0; }\n  .filter-group h3 { margin: 0 0 11px; color: var(--ink-secondary); font: 700 11px var(--font-body); letter-spacing: .08em; text-transform: uppercase; }\n  .category-row { position: relative; display: flex; align-items: center; min-height: 31px; padding-left: 12px; color: var(--ink-secondary); font-size: 13px; cursor: pointer; }\n  .category-row::before { content: ''; position: absolute; left: 0; width: 3px; height: 0; background: var(--ink); transition: height .18s ease; }\n  .category-row.active { color: var(--ink); font-weight: 700; }\n  .category-row.active::before { height: 20px; }\n  .category-row:hover { color: var(--ink); }\n  .filter-inputs { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }\n  .filter-inputs input, .year-input { width: 100%; box-sizing: border-box; height: 36px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--paper); color: var(--ink); padding: 0 9px; font: 400 12px var(--font-body); outline: none; }\n  .filter-inputs input:focus, .year-input:focus { border-color: var(--ink); box-shadow: 0 0 0 3px rgba(43,33,64,.08); }\n  .filter-button { width: 100%; margin-top: 9px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: transparent; color: var(--ink); padding: 9px 10px; font: 700 12px var(--font-body); cursor: pointer; }\n  .filter-button:hover { border-color: var(--ink); background: var(--paper-warm); }\n  .results-area { min-width: 0; }\n  .active-filters { display: flex; align-items: center; gap: 8px; min-height: 24px; margin-bottom: 17px; }\n  .filter-tag { display: inline-flex; align-items: center; gap: 6px; border: 1px solid rgba(106,75,196,.24); border-radius: 4px; background: var(--ribbon-lavender-bg); color: var(--ribbon-lavender); padding: 5px 8px; font-size: 11px; font-weight: 600; }\n  .filter-tag button { border: 0; background: none; color: inherit; padding: 0; font-size: 13px; cursor: pointer; }\n  .index-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }\n  .index-tile { display: grid; grid-template-columns: 82px minmax(0, 1fr); gap: 15px; min-height: 144px; border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--paper-card); padding: 14px; }\n  .index-tile:hover { border-color: var(--ink); }\n  .cover-box { width: 82px; height: 116px; overflow: hidden; border-radius: 4px; background: var(--paper-warm); }\n  .cover-art { position: relative; width: 100%; height: 100%; display: flex; flex-direction: column; justify-content: space-between; box-sizing: border-box; padding: 10px 8px; color: var(--paper); }\n  .cover-art::after { content: ''; position: absolute; left: 8px; right: 8px; bottom: 32px; height: 1px; background: rgba(255,255,255,.42); }\n  .cover-art .cover-kicker { position: relative; z-index: 1; font: 700 7px/1.2 var(--font-number); letter-spacing: .13em; text-transform: uppercase; opacity: .82; }\n  .cover-art .cover-title { position: relative; z-index: 1; max-width: 72px; font: 700 16px/1.03 var(--font-heading); letter-spacing: -.04em; }\n  .cover-art .cover-author { position: relative; z-index: 1; font: 600 7px/1.2 var(--font-body); opacity: .86; }\n  .cover-amber { background: #8E522A; }\n  .cover-amber::before { content: ''; position: absolute; width: 88px; height: 88px; right: -24px; top: 24px; border: 1px solid rgba(255,231,173,.5); border-radius: 50%; }\n  .cover-blue { background: #314E70; }\n  .cover-blue::before { content: ''; position: absolute; width: 56px; height: 56px; right: -8px; top: 20px; background: rgba(181,216,224,.28); transform: rotate(45deg); }\n  .cover-sage { background: #45655C; }\n  .cover-sage::before { content: ''; position: absolute; width: 86px; height: 44px; right: -20px; top: 32px; border: 1px solid rgba(246,223,182,.45); border-radius: 50%; transform: rotate(-22deg); }\n  .cover-fallback { display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 8px; box-sizing: border-box; border: 1px solid var(--border); background: var(--paper-warm); color: var(--ink-muted); text-align: center; }\n  .cover-fallback .icon { color: var(--ink-secondary); font-size: 22px; }\n  .cover-fallback span { max-width: 62px; font: 700 8px/1.25 var(--font-number); letter-spacing: .08em; text-transform: uppercase; }\n  .tile-body { min-width: 0; display: flex; flex-direction: column; }\n  .tile-topline { display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; min-height: 20px; }\n  .tile-category { color: var(--ink-muted); font: 700 10px var(--font-body); letter-spacing: .08em; text-transform: uppercase; }\n  .status { display: inline-flex; align-items: center; border-radius: 4px; padding: 4px 6px; font: 700 9px/1 var(--font-body); white-space: nowrap; letter-spacing: .02em; }\n  .status.in-stock { border: 1px solid rgba(40,124,104,.24); background: var(--ribbon-sage-bg); color: var(--ribbon-sage); }\n  .status.out-stock { border: 1px solid rgba(217,74,61,.24); background: var(--ribbon-coral-bg); color: var(--ribbon-coral); }\n  .tile-title { display: block; margin: 8px 0 3px; color: var(--ink); font: 600 17px/1.2 var(--font-heading); letter-spacing: -.02em; text-decoration: none; }\n  .tile-title:hover { text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 3px; }\n  .tile-author { color: var(--ink-secondary); font-size: 12px; }\n  .tile-meta { display: flex; align-items: center; gap: 10px; margin-top: 9px; color: var(--ink-muted); font: 500 11px var(--font-number); }\n  .tile-meta .rating { color: var(--ribbon-marigold); font-weight: 700; }\n  .tile-bottom { display: flex; align-items: flex-end; justify-content: space-between; gap: 8px; margin-top: auto; padding-top: 10px; }\n  .tile-price { color: var(--ink); font: 700 17px var(--font-number); }\n  .tile-actions { display: flex; align-items: center; gap: 9px; }\n  .icon-button { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--paper-card); color: var(--ink-muted); cursor: pointer; }\n  .icon-button:hover, .icon-button.saved { border-color: var(--ribbon-coral); color: var(--ribbon-coral); }\n  .cart-action { border: 0; background: none; color: var(--ink); padding: 0; font: 700 11px var(--font-body); cursor: pointer; white-space: nowrap; }\n  .cart-action:hover { text-decoration: underline; text-underline-offset: 3px; }\n  .cart-action.disabled { color: var(--ink-muted); cursor: not-allowed; }\n\n  .record-strip { border-top: 1px solid var(--border); background: var(--paper-warm); padding: 34px 32px 38px; }\n  .record-strip-head { display: flex; align-items: baseline; justify-content: space-between; gap: 24px; margin-bottom: 20px; }\n  .record-strip-head h2 { margin: 0; font: 600 20px var(--font-heading); }\n  .record-strip-head p { margin: 0; color: var(--ink-muted); font-size: 11px; }\n  .record-grid { display: grid; grid-template-columns: 128px minmax(0, 1fr) 266px; gap: 24px; align-items: start; }\n  .record-cover { width: 128px; height: 176px; }\n  .record-copy { min-width: 0; }\n  .breadcrumb { display: flex; align-items: center; gap: 8px; color: var(--ink-muted); font-size: 11px; }\n  .breadcrumb strong { color: var(--ink); font-weight: 600; }\n  .record-title { margin: 12px 0 4px; font: 600 29px/1.18 var(--font-heading); letter-spacing: -.03em; }\n  .record-author { margin: 0; color: var(--ink-secondary); font-size: 13px; }\n  .record-author strong { color: var(--ink); }\n  .record-ribbons { display: flex; align-items: center; gap: 8px; margin-top: 13px; }\n  .ribbon { display: inline-flex; align-items: center; border-radius: 4px; padding: 5px 7px; font: 700 10px/1 var(--font-body); letter-spacing: .04em; text-transform: uppercase; }\n  .ribbon-lavender { border: 1px solid rgba(106,75,196,.24); background: var(--ribbon-lavender-bg); color: var(--ribbon-lavender); }\n  .ribbon-sage { border: 1px solid rgba(40,124,104,.24); background: var(--ribbon-sage-bg); color: var(--ribbon-sage); }\n  .record-description { max-width: 540px; margin: 17px 0 16px; color: var(--ink-secondary); font-size: 13px; line-height: 1.65; }\n  .facts { display: grid; grid-template-columns: 112px minmax(0, 1fr); max-width: 540px; border-top: 1px solid var(--border); }\n  .fact-row { display: contents; }\n  .fact-row span { padding: 8px 0; border-bottom: 1px solid var(--border); font-size: 12px; }\n  .fact-row span:first-child { color: var(--ink-muted); }\n  .fact-row span:last-child { color: var(--ink); font-weight: 600; }\n  .purchase-docket { border: 1px solid var(--border); background: var(--paper-card); padding: 18px; }\n  .docket-label { color: var(--ink-muted); font: 700 10px var(--font-body); letter-spacing: .1em; text-transform: uppercase; }\n  .docket-price { margin: 6px 0 15px; font: 700 26px var(--font-number); }\n  .docket-facts { display: grid; grid-template-columns: 1fr 1fr; border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); }\n  .docket-fact { padding: 10px 0; }\n  .docket-fact + .docket-fact { border-left: 1px solid var(--border); padding-left: 12px; }\n  .docket-fact small { display: block; color: var(--ink-muted); font-size: 10px; }\n  .docket-fact strong { display: block; margin-top: 3px; font: 700 13px var(--font-number); }\n  .quantity-line { display: flex; align-items: center; justify-content: space-between; margin: 15px 0; }\n  .quantity-line label { color: var(--ink-secondary); font-size: 12px; font-weight: 700; }\n  .quantity-stepper { display: inline-flex; align-items: center; border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--paper); }\n  .quantity-stepper button { width: 30px; height: 30px; border: 0; background: transparent; color: var(--ink); font: 700 14px var(--font-number); cursor: pointer; }\n  .quantity-stepper span { width: 28px; color: var(--ink); text-align: center; font: 700 12px var(--font-number); }\n  .docket-actions { display: grid; gap: 8px; }\n  .docket-actions button { width: 100%; min-height: 38px; }\n  .accent-action { border: 1px solid var(--ribbon-marigold); border-radius: var(--radius-sm); background: var(--ribbon-marigold); color: #fff; font: 700 12px var(--font-body); cursor: pointer; }\n  .secondary-docket-action { border: 1px solid var(--ink); border-radius: var(--radius-sm); background: var(--ink); color: var(--paper); font: 700 12px var(--font-body); cursor: pointer; }\n  .saved-action { display: inline-flex; align-items: center; justify-content: center; gap: 7px; border: 0; background: transparent; color: var(--ink-secondary); font: 600 11px var(--font-body); cursor: pointer; }\n  .saved-action:hover { color: var(--ribbon-coral); }\n\n  .footer-line { display: flex; align-items: center; justify-content: space-between; gap: 20px; max-width: 1200px; margin: 0 auto; padding: 20px 32px 24px; color: var(--ink-muted); font-size: 11px; }\n  .footer-links { display: flex; gap: 18px; }\n  .footer-links a { color: var(--ink-muted); text-decoration: none; }\n  .footer-links a:hover { color: var(--ink); }\n\n  @media (max-width: 920px) {\n    .bv-shell, .catalog-section, .record-strip { padding-left: 24px; padding-right: 24px; }\n    .masthead-inner { grid-template-columns: 1fr; gap: 28px; padding-left: 24px; padding-right: 24px; }\n    .record-grid { grid-template-columns: 104px minmax(0, 1fr); }\n    .record-cover { width: 104px; height: 144px; }\n    .purchase-docket { grid-column: 1 / -1; }\n  }\n  @media (max-width: 700px) {\n    .library-rail { height: auto; }\n    .rail-inner { min-height: 60px; padding-top: 10px; padding-bottom: 10px; flex-wrap: wrap; }\n    .task-nav { order: 3; width: 100%; height: 38px; overflow-x: auto; justify-content: flex-start; gap: 22px; }\n    .task-nav a { height: 38px; flex: 0 0 auto; }\n    .rail-actions .text-action { display: none; }\n    .masthead-copy h1 { font-size: 33px; }\n    .masthead-copy p { font-size: 14px; }\n    .index-line { align-items: flex-start; flex-direction: column; gap: 16px; }\n    .index-tools { width: 100%; justify-content: space-between; }\n    .filter-trigger { display: inline-flex; }\n    .catalog-layout { grid-template-columns: 1fr; padding-top: 20px; }\n    .filter-rail { display: none; }\n    .index-grid { grid-template-columns: 1fr; }\n    .record-grid { grid-template-columns: 88px minmax(0, 1fr); gap: 16px; }\n    .record-cover { width: 88px; height: 124px; }\n    .record-title { font-size: 24px; }\n    .record-description, .facts { max-width: none; }\n    .purchase-docket { grid-column: 1 / -1; }\n    .footer-line { align-items: flex-start; flex-direction: column; }\n  }\n</style>\n<div class=\"bv-page\" data-kid=\"1\">\n    <header class=\"library-rail\" data-kid=\"1-1\">\n        <div class=\"bv-shell rail-inner\" data-kid=\"1-1-1\">\n            <a aria-label=\"BookVerse, trang chủ\" class=\"brand-mark\" data-kid=\"1-1-1-1\" href=\"#\">\n                <i aria-hidden=\"true\" class=\"ti ti-book-2 icon\" data-kid=\"1-1-1-1-1\">\n                </i>\n                <span class=\"brand-name\" data-kid=\"1-1-1-1-2\">\n                    BookVerse\n                </span>\n            </a>\n            <nav aria-label=\"Điều hướng chính\" class=\"task-nav\" data-kid=\"1-1-1-2\">\n                <a class=\"active\" data-kid=\"1-1-1-2-1\" href=\"#\">\n                    Trang chủ\n                </a>\n                <a data-kid=\"1-1-1-2-2\" href=\"#\">\n                    Yêu thích\n                </a>\n                <a data-kid=\"1-1-1-2-3\" href=\"#\">\n                    Giỏ hàng\n                    <span class=\"font-number\" data-dynamic=\"true\" data-kid=\"1-1-1-2-3-1\" data-name=\"cart items count badge\" data-reason=\"text updated when cart items change\" style=\"margin-left:5px;color:var(--ribbon-marigold);font-size:11px;\">\n                        0\n                    </span>\n                </a>\n                <a data-kid=\"1-1-1-2-4\" href=\"#\">\n                    Đơn mua\n                </a>\n            </nav>\n            <div class=\"rail-actions\" data-kid=\"1-1-1-3\">\n                <a class=\"text-action\" data-kid=\"1-1-1-3-1\" href=\"#\">\n                    Đăng nhập\n                </a>\n                <a class=\"outline-action\" data-kid=\"1-1-1-3-2\" href=\"#\">\n                    Đăng ký\n                </a>\n            </div>\n        </div>\n    </header>\n    <section aria-labelledby=\"catalog-title\" class=\"masthead\" data-kid=\"1-2\">\n        <div class=\"bv-shell masthead-inner\" data-kid=\"1-2-1\">\n            <div class=\"masthead-copy\" data-kid=\"1-2-1-1\">\n                <div aria-hidden=\"true\" class=\"masthead-rule\" data-kid=\"1-2-1-1-1\">\n                </div>\n                <h1 data-kid=\"1-2-1-1-2\" id=\"catalog-title\">\n                    Đắm mình vào từng trang sách hay\n                </h1>\n                <p data-kid=\